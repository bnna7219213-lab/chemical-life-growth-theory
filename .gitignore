# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Data (large, non-tracked; keep raw data out of version control)
data/raw/*.csv
data/raw/*.tsv
data/raw/*.h5ad
data/raw/*.h5
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports (generated)
reports/*.png
reports/*.pdf
reports/*.svg
!reports/README.md

# Logs
*.log

# Environment / secrets
.env
.env.local
*.local

# pandoc / LaTeX intermediate files
*.aux
*.out
*.toc
*.synctex.gz
